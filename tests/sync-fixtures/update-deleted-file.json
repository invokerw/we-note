  "description": "文件在 revision 3 被软删除。成功的内容更新必须恢复 is_deleted=false，并让最后一条 Change、文件状态、版本 metadata 与当前指针保持一致，不能留下 200 后仍为删除态的自相矛盾状态。",
  "steps": [
    {
      "id": "update-soft-deleted-file",
      "description": "以已删除文件的历史版本为基准提交内容：成功写入后 is_deleted 必须恢复为 false，最后一条 Change 是 update_file_content。",
      "content_file": "notes/todo-v1.txt",
      "request": {
        "method": "POST",
        "endpoint": "/api/v1/vaults/vault_demo_0001/sync/changes",
        "headers": {
          "Idempotency-Key": "op_doc_restore"
        },
        "body": {
          "mode": "submit",
          "vault_id": "vault_demo_0001",
          "device_id": "device_mac_0001",
          "operation_id": "op_doc_restore",
          "file_id": "file_doc",
          "operation": "update_file_content",
          "path": "notes/doc.txt",
          "base_revision": 3,
          "blob_reference": "upload_doc_restore",
          "content_hash": "sha256:811349c57bbe210e7f90aaa3c18abe9c9993557f11d61408104c392217c73f8c",
          "content_size": 93,
          "client_timestamp": "2026-11-21T09:10:00Z",
          "metadata": {
            "format": "txt",
            "line_ending": "lf"
          },
          "base_version_id": "ver_doc_02",
          "base_content_hash": "sha256:e7a5e289ce04c32e9bfaf6727cb66f701b3cdab9d3fb4dca800fc09b84dae0db"
        }
      },
      "expected_status": 200,
      "expected_result": {
        "mode": "submit",
        "replayed": false,
        "operation_id": "op_doc_restore",
        "file_id": "file_doc",
        "version_id": "ver_doc_03",
        "parent_version_id": "ver_doc_02",
        "change_id": "chg_000004",
        "content_hash": "sha256:811349c57bbe210e7f90aaa3c18abe9c9993557f11d61408104c392217c73f8c",
        "vault_revision": 4
      },
      "expected_state": {
        "vault_revision": 4,
        "counts.versions": 3,
        "counts.changes": 4,
        "files.file_doc.is_deleted": false,
        "files.file_doc.current_version_id": "ver_doc_03",
        "last_change.operation": "update_file_content",
        "versions.ver_doc_03.metadata.format": "txt",
        "versions.ver_doc_03.metadata.line_ending": "lf"
      }
    },
    {
      "id": "manifest-shows-restored-file",
      "description": "恢复后 manifest 必须把该文件报告为非删除态与新版本。",
      "request": {
        "method": "GET",
        "endpoint": "/api/v1/vaults/vault_demo_0001/sync/manifest",
        "headers": {
          "X-Device-Id": "device_mac_0001"
        }
      },
      "expected_status": 200,
      "expect_manifest_restores_map": true,
      "expect_state_unchanged": true,
      "expected_result": {
        "mode": "manifest",
        "vault_id": "vault_demo_0001",
        "snapshot_revision": 4,
        "files": [
          {
            "file_id": "file_doc",
            "path": "notes/doc.txt",
            "format": "txt",
            "current_version_id": "ver_doc_03",
            "current_content_hash": "sha256:811349c57bbe210e7f90aaa3c18abe9c9993557f11d61408104c392217c73f8c",
            "content_size": 93,
            "is_deleted": false
          }
        ]
      },
      "expected_state": {
        "vault_revision": 4,
        "counts.changes": 4
      }
    }
  ],
