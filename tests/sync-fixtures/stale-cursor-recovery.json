    {
      "id": "resume-from-snapshot-revision",
      "description": "按 manifest 快照恢复后从 snapshot_revision 续拉，快照之后的变更恰好出现一次。请求游标不在此处硬编码：执行时从 fetch-manifest-snapshot 响应的 snapshot_revision 注入。",
      "cursor_from_step": 3,
      "cursor_from_field": "snapshot_revision",
      "request": {
        "method": "POST",
        "endpoint": "/api/v1/vaults/vault_demo_0001/sync/changes",
        "headers": {},
        "body": {
          "mode": "pull",
          "vault_id": "vault_demo_0001",
          "device_id": "device_mac_0001"
        }
      },
      "expected_status": 200,
      "expect_state_unchanged": true,
      "expected_result": {
        "mode": "pull",
        "vault_id": "vault_demo_0001",
        "device_id": "device_mac_0001",
        "to_revision": 7,
        "changes": [
          {
            "change_id": "chg_000007",
            "vault_revision": 7,
            "file_id": "file_gamma",
            "version_id": "ver_gamma_02"
          }
        ],
        "has_more": false
      },
      "expected_state": {
        "vault_revision": 7,
        "counts.changes": 5
      }
    },
    {
      "id": "fetch-manifest-after-resume",
      "description": "续拉之后再次获取 manifest，快照 revision 已推进到 7；用于验证同一绑定逻辑在 revision 6 与 7 两个游标上都按实际响应取值。",
      "request": {
        "method": "GET",
        "endpoint": "/api/v1/vaults/vault_demo_0001/sync/manifest",
        "headers": {
          "X-Device-Id": "device_mac_0001"
        },
        "query": {
          "device_id": "device_mac_0001"
        }
      },
      "expected_status": 200,
      "expect_state_unchanged": true,
      "expect_manifest_restores_map": true,
      "expected_result": {
        "mode": "manifest",
        "vault_id": "vault_demo_0001",
        "snapshot_revision": 7,
        "min_available_revision": 3
      },
      "expected_state": {
        "vault_revision": 7,
        "counts.changes": 5
      }
    },
    {
      "id": "resume-from-second-snapshot",
      "description": "从第二个 manifest 响应的 snapshot_revision（7）续拉：快照已包含 revision 7 的变更，因此必须返回空数组。若执行器把游标写死为 6，就会多返回 chg_000007。",
      "cursor_from_step": 6,
      "cursor_from_field": "snapshot_revision",
      "request": {
        "method": "POST",
        "endpoint": "/api/v1/vaults/vault_demo_0001/sync/changes",
        "headers": {},
        "body": {
          "mode": "pull",
          "vault_id": "vault_demo_0001",
          "device_id": "device_mac_0001"
