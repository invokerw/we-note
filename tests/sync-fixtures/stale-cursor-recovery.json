  "steps": [
    {
      "id": "pull-at-lower-bound",
      "description": "游标恰好等于 min_available_revision（3）时仍可增量，返回 4、5、6 三条 Change。",
      "request": {
        "method": "POST",
        "endpoint": "/api/v1/vaults/vault_demo_0001/sync/changes",
        "headers": {},
        "body": {
          "mode": "pull",
          "vault_id": "vault_demo_0001",
          "device_id": "device_mac_0001",
          "last_server_revision": 3
        }
      },
      "expected_status": 200,
      "expect_state_unchanged": true,
      "expected_result": {
        "mode": "pull",
        "vault_id": "vault_demo_0001",
        "device_id": "device_mac_0001",
        "from_revision": 3,
        "to_revision": 6,
        "min_available_revision": 3,
        "changes": [
          {
            "change_id": "chg_000004",
            "vault_revision": 4
          },
          {
            "change_id": "chg_000005",
            "vault_revision": 5
          },
          {
            "change_id": "chg_000006",
            "vault_revision": 6
          }
        ],
        "has_more": false
      },
      "expected_state": {
        "vault_revision": 6
      }
    },
    {
      "id": "pull-two-below-lower-bound",
      "description": "游标 2 严格小于下界 3（距离为 1），同样必须返回 CURSOR_TOO_OLD；用于证明判定是严格小于而不是小于下界再减一。",
      "request": {
        "method": "POST",
        "endpoint": "/api/v1/vaults/vault_demo_0001/sync/changes",
        "headers": {},
        "body": {
          "mode": "pull",
          "vault_id": "vault_demo_0001",
          "device_id": "device_mac_0001",
          "last_server_revision": 2
        }
      },
      "expected_status": 409,
      "expect_state_unchanged": true,
      "expect_error_fields": {
        "code": "CURSOR_TOO_OLD",
        "requested_revision": 2,
        "min_available_revision": 3,
        "current_vault_revision": 6,
        "manifest_endpoint": "/api/v1/vaults/vault_demo_0001/sync/manifest",
        "endpoint": "/api/v1/vaults/vault_demo_0001/sync/changes",
        "method": "POST",
        "allowed_method": "POST"
      },
      "expected_result": {
        "code": "CURSOR_TOO_OLD",
        "requested_revision": 2,
        "min_available_revision": 3,
        "current_vault_revision": 6
      }
    },
    {
      "id": "pull-below-lower-bound",
      "description": "游标 1 严格小于下界 3，必须返回 CURSOR_TOO_OLD，并给出下界与 manifest 入口。",
      "request": {
        "method": "POST",
        "endpoint": "/api/v1/vaults/vault_demo_0001/sync/changes",
        "headers": {},
        "body": {
          "mode": "pull",
          "vault_id": "vault_demo_0001",
          "device_id": "device_mac_0001",
          "last_server_revision": 1
        }
      },
      "expected_status": 409,
      "expect_state_unchanged": true,
      "expect_error_fields": {
        "code": "CURSOR_TOO_OLD",
        "vault_id": "vault_demo_0001",
        "device_id": "device_mac_0001",
        "requested_revision": 1,
        "min_available_revision": 3,
        "current_vault_revision": 6,
        "manifest_endpoint": "/api/v1/vaults/vault_demo_0001/sync/manifest"
      },
      "expected_result": {
        "code": "CURSOR_TOO_OLD",
        "vault_id": "vault_demo_0001",
        "requested_revision": 1,
        "min_available_revision": 3,
        "current_vault_revision": 6,
        "manifest_endpoint": "/api/v1/vaults/vault_demo_0001/sync/manifest"
      }
    },
