  "steps": [
    {
      "id": "pull-with-last-request-id",
      "description": "序号 999999 仍然是合法的六位 request_id。",
      "request": {
        "method": "POST",
        "endpoint": "/api/v1/vaults/vault_demo_0001/sync/changes",
        "headers": {},
        "body": {
          "mode": "pull",
          "vault_id": "vault_demo_0001",
          "device_id": "device_mac_0001",
          "last_server_revision": 1
        }
      },
      "expected_status": 200,
      "expect_state_unchanged": true,
      "expected_result": {
        "mode": "pull",
        "vault_id": "vault_demo_0001",
        "device_id": "device_mac_0001",
        "request_id": "req_999999",
        "from_revision": 1,
        "to_revision": 1,
        "changes": [],
        "has_more": false
      },
      "expected_state": {
        "vault_revision": 1,
        "counts.changes": 1
      }
    },
    {
      "id": "pull-after-sequence-exhausted",
      "description": "下一个序号超出 1..999999：必须返回 503 REQUEST_ID_EXHAUSTED 且 request_id 为 null。",
      "request": {
        "method": "POST",
        "endpoint": "/api/v1/vaults/vault_demo_0001/sync/changes",
        "headers": {},
        "body": {
          "mode": "pull",
          "vault_id": "vault_demo_0001",
          "device_id": "device_mac_0001",
          "last_server_revision": 1
        }
      },
      "expected_status": 503,
      "expect_state_unchanged": true,
      "expect_error_fields": {
        "code": "REQUEST_ID_EXHAUSTED",
        "request_id": null,
        "endpoint": "/api/v1/vaults/vault_demo_0001/sync/changes",
        "method": "POST",
        "allowed_method": "POST"
      },
      "expected_result": {
        "code": "REQUEST_ID_EXHAUSTED",
        "request_id": null
      },
      "expected_state": {
        "vault_revision": 1,
        "counts.changes": 1
      }
    }
  ],
