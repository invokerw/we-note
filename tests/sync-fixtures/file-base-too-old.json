  "steps": [
    {
      "id": "remote-advances-settings",
      "description": "Web 端把 settings.json 推进到 v2，revision 由 2 到 3。",
      "content_file": "data/settings-v2.json",
      "request": {
        "method": "POST",
        "endpoint": "/api/v1/vaults/vault_demo_0001/sync/changes",
        "headers": {
          "Idempotency-Key": "op_settings_v2_0001"
        },
        "body": {
          "mode": "submit",
          "vault_id": "vault_demo_0001",
          "device_id": "device_web_0001",
          "operation_id": "op_settings_v2_0001",
          "file_id": "file_settings",
          "operation": "update_file_content",
          "path": "data/settings.json",
          "base_revision": 2,
          "blob_reference": "upload_settings_v2",
          "content_hash": "sha256:93ebd40144b3c07fa3e3da5336efdc92fbf276791700249011b923363ad552b4",
          "content_size": 220,
          "client_timestamp": "2026-11-21T09:05:00Z",
          "metadata": {
            "format": "json",
            "line_ending": "lf"
          },
          "base_version_id": "ver_settings_01"
        }
      },
      "expected_status": 200,
      "expected_result": {
        "mode": "submit",
        "version_id": "ver_settings_02",
        "parent_version_id": "ver_settings_01",
        "change_id": "chg_000003",
        "vault_revision": 3
      },
      "expected_state": {
        "vault_revision": 3,
        "counts.versions": 3,
        "counts.changes": 3,
        "files.file_settings.current_version_id": "ver_settings_02"
      }
    },
    {
      "id": "stale-local-json-rejected",
      "description": "Mac 端基于 settings-v1 修改出的 settings-v3 用新 operation_id 提交，基准版本已被远端推进。",
      "content_file": "data/settings-v3.json",
      "request": {
        "method": "POST",
        "endpoint": "/api/v1/vaults/vault_demo_0001/sync/changes",
        "headers": {
          "Idempotency-Key": "op_settings_v3_conflict"
        },
        "body": {
          "mode": "submit",
          "vault_id": "vault_demo_0001",
          "device_id": "device_mac_0001",
          "operation_id": "op_settings_v3_conflict",
          "file_id": "file_settings",
          "operation": "update_file_content",
          "path": "data/settings.json",
          "base_revision": 2,
          "blob_reference": "upload_settings_v3",
          "content_hash": "sha256:6dd374abe26f66aa5211b7d76bfa822168ba4f8af1b3e0e8490d2fd517d966d9",
          "content_size": 243,
          "client_timestamp": "2026-11-21T09:10:00Z",
          "metadata": {
            "format": "json",
            "line_ending": "lf"
          },
          "base_version_id": "ver_settings_01",
          "base_content_hash": "sha256:21c9b70a1c1f2379c3fc4dd2374977266e222f4996a3d327188c67261911aa73"
        }
      },
      "expected_status": 409,
      "expect_state_unchanged": true,
      "expect_conflict_locates_remote": "data/settings-v2.json",
      "expected_result": {
        "code": "FILE_VERSION_CONFLICT",
        "file_id": "file_settings",
        "path": "data/settings.json",
        "base_version_id": "ver_settings_01",
        "base_content_hash": "sha256:21c9b70a1c1f2379c3fc4dd2374977266e222f4996a3d327188c67261911aa73",
        "current_version_id": "ver_settings_02",
        "current_content_hash": "sha256:93ebd40144b3c07fa3e3da5336efdc92fbf276791700249011b923363ad552b4",
        "current_content_size": 220,
        "current_blob_id": "blob_93ebd40144b3c07fa3e3da5336efdc92fbf276791700249011b923363ad552b4",
        "conflict_resolution": "fetch_current_version_then_three_way_merge"
      }
    },
    {
      "id": "version-matches-hash-stale-rejected",
      "description": "基准版本仍与远端当前版本一致，但 base_content_hash 是旧版本的哈希。任一项不匹配即必须返回 FILE_VERSION_CONFLICT，且状态无副作用。",
      "content_file": "data/settings-v3.json",
      "request": {
        "method": "POST",
        "endpoint": "/api/v1/vaults/vault_demo_0001/sync/changes",
        "headers": {
          "Idempotency-Key": "op_settings_v3_version_only"
        },
        "body": {
          "mode": "submit",
          "vault_id": "vault_demo_0001",
          "device_id": "device_mac_0001",
          "operation_id": "op_settings_v3_version_only",
          "file_id": "file_settings",
          "operation": "update_file_content",
          "path": "data/settings.json",
          "base_revision": 3,
          "blob_reference": "upload_settings_v3",
          "content_hash": "sha256:6dd374abe26f66aa5211b7d76bfa822168ba4f8af1b3e0e8490d2fd517d966d9",
          "content_size": 243,
          "client_timestamp": "2026-11-21T09:15:00Z",
          "metadata": {
            "format": "json",
            "line_ending": "lf"
          },
          "base_version_id": "ver_settings_02",
          "base_content_hash": "sha256:21c9b70a1c1f2379c3fc4dd2374977266e222f4996a3d327188c67261911aa73"
        }
      },
      "expected_status": 409,
      "expect_state_unchanged": true,
      "expect_conflict_locates_remote": "data/settings-v2.json",
      "expected_result": {
        "code": "FILE_VERSION_CONFLICT",
        "file_id": "file_settings",
        "path": "data/settings.json",
        "base_version_id": "ver_settings_02",
        "base_content_hash": "sha256:21c9b70a1c1f2379c3fc4dd2374977266e222f4996a3d327188c67261911aa73",
        "current_version_id": "ver_settings_02",
        "current_content_hash": "sha256:93ebd40144b3c07fa3e3da5336efdc92fbf276791700249011b923363ad552b4",
        "current_content_size": 220,
        "current_blob_id": "blob_93ebd40144b3c07fa3e3da5336efdc92fbf276791700249011b923363ad552b4",
        "conflict_resolution": "fetch_current_version_then_three_way_merge"
      }
    },
    {
      "id": "hash-matches-version-stale-rejected",
      "description": "base_content_hash 与远端当前版本一致，但 base_version_id 指向已被取代的旧版本。版本不匹配同样必须返回 FILE_VERSION_CONFLICT，且状态无副作用。",
      "content_file": "data/settings-v3.json",
      "request": {
