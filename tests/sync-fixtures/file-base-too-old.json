    {
      "id": "pull-confirms-no-new-change",
      "description": "两次冲突都没有产生 Change，从 revision 2 拉取只剩第一次成功提交的那一条。",
      "request": {
        "method": "POST",
        "endpoint": "/api/v1/vaults/vault_demo_0001/sync/changes",
        "headers": {},
        "body": {
          "mode": "pull",
          "vault_id": "vault_demo_0001",
          "device_id": "device_mac_0001",
          "last_server_revision": 2
        }
      },
      "expected_status": 200,
      "expect_state_unchanged": true,
      "expected_result": {
        "mode": "pull",
        "vault_id": "vault_demo_0001",
        "device_id": "device_mac_0001",
        "from_revision": 2,
        "to_revision": 3,
        "changes": [
          {
            "change_id": "chg_000003",
            "vault_revision": 3,
            "file_id": "file_settings",
            "version_id": "ver_settings_02"
          }
        ],
        "has_more": false
      },
      "expected_state": {
        "vault_revision": 3,
        "counts.versions": 3,
        "counts.changes": 3
      }
    },
    {
      "id": "vault-mismatch-expected-vault-id",
      "description": "请求体 vault_id 与路由不一致时返回 VAULT_MISMATCH，并必须给出服务端期望的 expected_vault_id。",
      "request": {
        "method": "POST",
        "endpoint": "/api/v1/vaults/vault_demo_0001/sync/changes",
        "headers": {},
        "body": {
          "mode": "pull",
          "vault_id": "vault_other_9999",
          "device_id": "device_mac_0001",
          "last_server_revision": 2
        }
      },
      "expected_status": 400,
      "expect_state_unchanged": true,
      "expect_error_fields": {
        "code": "VAULT_MISMATCH",
        "vault_id": "vault_other_9999",
        "expected_vault_id": "vault_demo_0001"
      },
      "expected_result": {
        "code": "VAULT_MISMATCH",
        "vault_id": "vault_other_9999",
        "expected_vault_id": "vault_demo_0001"
      }
    }
