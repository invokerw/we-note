  "scenario": "file-base-too-old",
  "title": "同一文件基准过旧",
  "content_samples": {
    "remote.current": "data/settings-v2.json",
    "local.stale_base": "data/settings-v1.json",
    "local.candidate": "data/settings-v3.json"
  },
