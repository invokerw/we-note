  "steps": [
    {
      "id": "pull-at-lower-bound",
      "description": "游标 3 等于下界，仍可增量：返回保留的 revision 4、5 两条 Change。",
      "request": {
        "method": "POST",
        "endpoint": "/api/v1/vaults/vault_demo_0001/sync/changes",
        "headers": {},
        "body": {
          "mode": "pull",
          "vault_id": "vault_demo_0001",
          "device_id": "device_mac_0001",
          "last_server_revision": 3
        }
      },
      "expected_status": 200,
      "expect_state_unchanged": true,
      "expected_result": {
        "mode": "pull",
        "vault_id": "vault_demo_0001",
        "device_id": "device_mac_0001",
        "from_revision": 3,
        "to_revision": 5,
        "changes": [
          {
            "change_id": "chg_000004",
            "vault_revision": 4
          },
          {
            "change_id": "chg_000005",
            "vault_revision": 5
          }
        ],
        "has_more": false
      },
      "expected_state": {
        "vault_revision": 5,
        "counts.changes": 2
      }
    },
    {
      "id": "fetch-manifest-after-compression",
      "description": "manifest 必须重建被压缩文件的当前版本映射：file_notes 仍指向初始快照中的 ver_notes_02。",
      "request": {
        "method": "GET",
        "endpoint": "/api/v1/vaults/vault_demo_0001/sync/manifest",
        "headers": {
          "X-Device-Id": "device_mac_0001"
        }
      },
      "expected_status": 200,
      "expect_manifest_restores_map": true,
      "expect_state_unchanged": true,
      "expected_result": {
        "mode": "manifest",
        "vault_id": "vault_demo_0001",
        "snapshot_revision": 5,
        "min_available_revision": 3,
        "files": [
          {
            "file_id": "file_beta",
            "path": "data/settings.json",
            "format": "json",
            "current_version_id": "ver_beta_02",
            "current_content_hash": "sha256:6dd374abe26f66aa5211b7d76bfa822168ba4f8af1b3e0e8490d2fd517d966d9",
            "content_size": 243
          },
          {
            "file_id": "file_notes",
            "path": "notes/todo.txt",
            "format": "txt",
            "current_version_id": "ver_notes_02",
            "current_content_hash": "sha256:811349c57bbe210e7f90aaa3c18abe9c9993557f11d61408104c392217c73f8c",
            "content_size": 93
          }
        ]
      },
      "expected_state": {
        "vault_revision": 5,
        "counts.changes": 2
      }
    },
    {
      "id": "update-after-compression",
      "description": "压缩后的状态仍可继续写入：以 file_beta 的当前版本为基准提交新内容，新 Change 的 revision 为 6。",
      "content_file": "data/settings-v1.json",
      "request": {
        "method": "POST",
        "endpoint": "/api/v1/vaults/vault_demo_0001/sync/changes",
        "headers": {
          "Idempotency-Key": "op_settings_final"
        },
        "body": {
