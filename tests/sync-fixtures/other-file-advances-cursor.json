  "steps": [
    {
      "id": "submit-settings-v2",
      "description": "Web 设备更新 settings.json，Vault 游标由 2 推进到 3。",
      "content_file": "data/settings-v2.json",
      "request": {
        "method": "POST",
        "endpoint": "/api/v1/vaults/vault_demo_0001/sync/changes",
        "headers": {
          "Idempotency-Key": "op_settings_v2_0001"
        },
        "body": {
          "mode": "submit",
          "vault_id": "vault_demo_0001",
          "device_id": "device_web_0001",
          "operation_id": "op_settings_v2_0001",
          "file_id": "file_settings",
          "operation": "update_file_content",
          "path": "data/settings.json",
          "base_revision": 2,
          "blob_reference": "upload_settings_v2",
          "content_hash": "sha256:93ebd40144b3c07fa3e3da5336efdc92fbf276791700249011b923363ad552b4",
          "content_size": 220,
          "client_timestamp": "2026-11-21T09:05:00Z",
          "metadata": {
            "format": "json",
            "line_ending": "lf"
          },
          "base_version_id": "ver_settings_01"
        }
      },
      "expected_status": 200,
      "expected_result": {
        "mode": "submit",
        "replayed": false,
        "device_id": "device_web_0001",
        "file_id": "file_settings",
        "version_id": "ver_settings_02",
        "parent_version_id": "ver_settings_01",
        "change_id": "chg_000003",
        "blob_id": "blob_93ebd40144b3c07fa3e3da5336efdc92fbf276791700249011b923363ad552b4",
        "vault_revision": 3
      },
      "expected_state": {
        "vault_revision": 3,
        "counts.versions": 3,
        "counts.changes": 3,
        "files.file_settings.current_version_id": "ver_settings_02",
        "files.file_todo.current_version_id": "ver_todo_01"
      }
    },
    {
      "id": "submit-todo-with-stale-base-revision",
      "description": "Mac 设备带着已经过时的 base_revision=2 提交 todo.txt，但 base_content_hash 仍与目标文件当前版本匹配，因此必须成功。",
      "content_file": "notes/todo-v2.txt",
      "request": {
        "method": "POST",
        "endpoint": "/api/v1/vaults/vault_demo_0001/sync/changes",
        "headers": {
          "Idempotency-Key": "op_todo_v2_0001"
        },
        "body": {
          "mode": "submit",
          "vault_id": "vault_demo_0001",
          "device_id": "device_mac_0001",
          "operation_id": "op_todo_v2_0001",
          "file_id": "file_todo",
          "operation": "update_file_content",
          "path": "notes/todo.txt",
          "base_revision": 2,
          "blob_reference": "upload_todo_v2",
          "content_hash": "sha256:e7a5e289ce04c32e9bfaf6727cb66f701b3cdab9d3fb4dca800fc09b84dae0db",
          "content_size": 137,
          "client_timestamp": "2026-11-21T09:10:00Z",
          "metadata": {
            "format": "txt",
            "line_ending": "lf"
          },
          "base_content_hash": "sha256:811349c57bbe210e7f90aaa3c18abe9c9993557f11d61408104c392217c73f8c"
        }
      },
      "expected_status": 200,
      "expected_result": {
        "mode": "submit",
        "replayed": false,
        "device_id": "device_mac_0001",
        "file_id": "file_todo",
        "version_id": "ver_todo_02",
        "parent_version_id": "ver_todo_01",
        "change_id": "chg_000004",
        "vault_revision": 4
      },
      "expected_state": {
        "vault_revision": 4,
        "counts.versions": 4,
        "counts.changes": 4,
        "files.file_todo.current_version_id": "ver_todo_02",
        "files.file_todo.current_content_hash": "sha256:e7a5e289ce04c32e9bfaf6727cb66f701b3cdab9d3fb4dca800fc09b84dae0db",
        "files.file_settings.current_version_id": "ver_settings_02",
        "files.file_settings.current_content_hash": "sha256:93ebd40144b3c07fa3e3da5336efdc92fbf276791700249011b923363ad552b4",
        "versions.ver_settings_02.base_version_id": "ver_settings_01",
        "change_ids": [
          "chg_000001",
          "chg_000002",
          "chg_000003",
          "chg_000004"
        ]
      }
    },
    {
      "id": "pull-both-changes",
      "description": "从 revision 2 拉取，两条新 Change 按 revision 递增返回，且各自指向正确文件。",
      "request": {
        "method": "POST",
        "endpoint": "/api/v1/vaults/vault_demo_0001/sync/changes",
        "headers": {},
        "body": {
          "mode": "pull",
          "vault_id": "vault_demo_0001",
          "device_id": "device_mac_0001",
          "last_server_revision": 2
        }
      },
      "expected_status": 200,
      "expect_state_unchanged": true,
      "expected_result": {
        "mode": "pull",
        "vault_id": "vault_demo_0001",
        "device_id": "device_mac_0001",
        "from_revision": 2,
        "to_revision": 4,
        "changes": [
          {
            "change_id": "chg_000003",
            "vault_revision": 3,
            "file_id": "file_settings",
            "version_id": "ver_settings_02"
          },
          {
            "change_id": "chg_000004",
            "vault_revision": 4,
            "file_id": "file_todo",
            "version_id": "ver_todo_02"
          }
        ],
        "has_more": false
      },
      "expected_state": {
        "vault_revision": 4,
        "counts.changes": 4
      }
    }
  ],
